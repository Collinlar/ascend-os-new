# Supabase (PostgreSQL). Server-side keys never ship to the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API (AI catalogue assistance, Shop onboarding)
GROQ_API_KEY=
# Optional. Overrides the vision model without a deploy, for when Groq
# retires one. Must accept images.
GROQ_MODEL=

# Payments (Paystack: MTN MoMo + card + bank transfer)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# WhatsApp (360dialog) and OTP (Africa's Talking or Twilio)
WHATSAPP_360DIALOG_API_KEY=
WHATSAPP_TEMPLATE_NAMESPACE=
# Shared secret for the inbound WhatsApp webhook, which opens the 24-hour
# customer service window. Without it the endpoint refuses every request.
WHATSAPP_VERIFY_TOKEN=
OTP_PROVIDER_API_KEY=

# Session signing secret (long random string; rotate = sign everyone out)
SESSION_SECRET=

# Shared secret for the outbox relay cron (Vercel cron sends it as a Bearer token)
CRON_SECRET=

# Public base URL, used in customer links sent over WhatsApp
NEXT_PUBLIC_APP_URL=

# Country configuration
DEFAULT_COUNTRY=GH
DEFAULT_CURRENCY=GHS
